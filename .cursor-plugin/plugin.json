{
  "name": "moxo",
  "displayName": "Moxo",
  "version": "1.3.0",
  "description": "Track flows, start workflows, and complete steps.",
  "author": {
    "name": "Moxo",
    "email": "support@moxo.com"
  },
  "homepage": "https://developers.moxo.com/docs/mcp",
  "repository": "https://github.com/try-moxo/moxo-agent-plugin",
  "license": "Apache-2.0",
  "logo": "assets/logo.png",
  "keywords": [
    "moxo",
    "workflow",
    "automation",
    "business-process",
    "client-portal",
    "approvals",
    "mcp"
  ],
  "category": "integrations",
  "tags": [
    "mcp",
    "workflow",
    "automation",
    "moxo"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "MOXO_API_TOKEN": {
        "type": "string",
        "title": "Moxo API token",
        "description": "A personal access token (starts with mxo_pat_) from Moxo under Settings → API keys → Create Personal Access Token."
      }
    },
    "required": [
      "MOXO_API_TOKEN"
    ]
  },
  "skills": "./skills/",
  "mcpServers": {
    "moxo": {
      "type": "http",
      "url": "https://api.moxo.com/mcp-server",
      "headers": {
        "Authorization": "Bearer ${MOXO_API_TOKEN}"
      }
    }
  }
}
